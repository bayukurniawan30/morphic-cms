
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=
# Storage Service Configuration (Default: CLOUDINARY)
STORAGE_SERVICE=CLOUDINARY

# Cloudinary Configuration (Required if STORAGE_SERVICE=CLOUDINARY)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# AWS S3 Configuration (Required if STORAGE_SERVICE=S3)
# AWS_S3_BUCKET=
# AWS_REGION= (shared with SES below)
# AWS_ACCESS_KEY_ID= (shared with SES below)
# AWS_SECRET_ACCESS_KEY= (shared with SES below)
# Email Service Configuration (Default: RESEND)
EMAIL_SERVICE=RESEND
RESEND_API_KEY=re_...
EMAIL_FROM=Morphic CMS <onboarding@resend.dev>

# AWS SES Configuration (Required if EMAIL_SERVICE=SES)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SIMPLE_HOMEPAGE=0

# Cloudflare Turnstile for public form
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
