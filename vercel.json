{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.ts"
    }
  ],
  "functions": {
    "index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-webhook-logs",
      "schedule": "0 0 * * *"
    }
  ]
}
